generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrgRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
  SITE_ENGINEER
  STORE_MANAGER
  PROCUREMENT
  FINANCE
  VIEWER
}

enum MemberRole {
  MANAGER
  ENGINEER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum WorkerStatus {
  ACTIVE
  ON_LEAVE
  ABSENT
  LATE
}

enum WorkerType {
  EMPLOYEE
  SUBCONTRACTOR
}

enum WorkerShift {
  DAY
  NIGHT
}

// ─── Core Entities ──────────────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  avatar        String?
  password      String
  emailVerified Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  organizations  UserOrganization[]
  projectMembers ProjectMember[]
  dailyReports   DailyReport[]
  documents      Document[]
  activities     Activity[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  invitations    Invitation[]     @relation("InvitedBy")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  address   String?
  gstNumber String?
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       UserOrganization[]
  projects      Project[]
  activities    Activity[]
  notifications Notification[]
  invitations   Invitation[]
  documents     Document[]
  workers       Worker[]

  @@map("organizations")
}

model UserOrganization {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole  @default(VIEWER)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_organizations")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Invitation {
  id             String    @id @default(uuid())
  email          String
  organizationId String
  role           OrgRole   @default(VIEWER)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id                 String          @id @default(uuid())
  name               String
  code               String
  description        String?
  clientName         String?
  location           String?
  status             ProjectStatus   @default(PLANNING)
  priority           ProjectPriority @default(MEDIUM)
  budget             Decimal?        @db.Decimal(15, 2)
  spent              Decimal         @default(0) @db.Decimal(15, 2)
  progress           Int             @default(0)
  startDate          DateTime?
  expectedCompletion DateTime?
  actualCompletion   DateTime?
  organizationId     String
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  members      ProjectMember[]
  dailyReports DailyReport[]
  documents    Document[]
  activities   Activity[]
  workers      Worker[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String     @id @default(uuid())
  projectId String
  userId    String
  role      MemberRole @default(ENGINEER)
  joinedAt  DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ─── Daily Reports ───────────────────────────────────────────────────────────

model DailyReport {
  id               String            @id @default(uuid())
  projectId        String
  organizationId   String
  submittedById    String
  date             DateTime          @db.Date
  weather          String?
  overallProgress  Int?
  workCompleted    String?
  remarks          String?
  labourCount      Int               @default(0)
  status           DailyReportStatus @default(DRAFT)
  aiSummary        String?
  labourDetails    Json?
  materialsConsumed Json?
  equipmentUsed    Json?
  issues           Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User       @relation(fields: [submittedById], references: [id])
  documents   Document[]

  @@index([projectId])
  @@index([organizationId])
  @@index([date])
  @@map("daily_reports")
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id             String   @id @default(uuid())
  name           String
  type           String
  mimeType       String
  size           Int
  url            String
  storageKey     String
  entityType     String
  entityId       String
  projectId      String?
  dailyReportId  String?
  organizationId String
  uploadedById   String
  createdAt      DateTime @default(now())

  project      Project?      @relation(fields: [projectId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  dailyReport  DailyReport?  @relation(fields: [dailyReportId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@map("documents")
}

// ─── Activity & Notifications ────────────────────────────────────────────────

model Activity {
  id             String   @id @default(uuid())
  type           String
  title          String
  description    String?
  metadata       Json?
  entityType     String?
  entityId       String?
  actorId        String
  projectId      String?
  organizationId String
  createdAt      DateTime @default(now())

  actor        User         @relation(fields: [actorId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([actorId])
  @@index([createdAt])
  @@map("activities")
}

model Notification {
  id             String           @id @default(uuid())
  type           NotificationType @default(INFO)
  title          String
  message        String
  read           Boolean          @default(false)
  entityType     String?
  entityId       String?
  userId         String
  organizationId String
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, read])
  @@index([organizationId])
  @@map("notifications")
}

// ─── Workforce ───────────────────────────────────────────────────────────────

model Worker {
  id                String        @id @default(uuid())
  name              String
  initials          String
  role              String
  trade             String
  type              WorkerType    @default(EMPLOYEE)
  phone             String?
  email             String?
  status            WorkerStatus  @default(ACTIVE)
  experienceYears   Int           @default(0)
  shift             WorkerShift   @default(DAY)
  attendancePercent Float         @default(0)
  lastCheckIn       String?
  supervisor        String?
  projectId         String?
  emergencyContact  Json?
  skills            String[]
  certifications    Json?
  ppeCompliant      Boolean       @default(true)
  weeklyAttendance  Json?
  recentActivity    Json?
  organizationId    String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([organizationId, status])
  @@map("workers")
}
