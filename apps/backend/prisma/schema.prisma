generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrgRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
  SITE_ENGINEER
  STORE_MANAGER
  PROCUREMENT
  FINANCE
  VIEWER
}

enum MemberRole {
  MANAGER
  ENGINEER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum WorkerStatus {
  ACTIVE
  ON_LEAVE
  ABSENT
  LATE
}

enum WorkerType {
  EMPLOYEE
  SUBCONTRACTOR
}

enum WorkerShift {
  DAY
  NIGHT
}

// ─── Core Entities ──────────────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  avatar        String?
  password      String
  emailVerified Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  organizations  UserOrganization[]
  projectMembers ProjectMember[]
  dailyReports   DailyReport[]
  documents      Document[]
  activities     Activity[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  invitations    Invitation[]       @relation("InvitedBy")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  address   String?
  gstNumber String?
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members               UserOrganization[]
  projects              Project[]
  activities            Activity[]
  notifications         Notification[]
  invitations           Invitation[]
  documents             Document[]
  workers               Worker[]
  materials             Material[]
  materialCategories    MaterialCategory[]
  materialSuppliers     MaterialSupplier[]
  materialMovements     MaterialMovement[]
  materialUsages        MaterialProjectUsage[]
  warehouses            Warehouse[]
  warehouseLocations    WarehouseLocation[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  stockTransfers        StockTransfer[]
  stockTransferItems    StockTransferItem[]
  stockAdjustments      StockAdjustment[]
  stockReservations     StockReservation[]
  inventoryAudits       InventoryAudit[]
  vendors               Vendor[]
  purchaseOrders        PurchaseOrder[]
  rfqs                  Rfq[]
  deliveries            Delivery[]
  invoices              Invoice[]
  payments              Payment[]
  budgetItems           BudgetItem[]
  cashFlowEntries       CashFlowEntry[]

  @@map("organizations")
}

model UserOrganization {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole  @default(VIEWER)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_organizations")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Invitation {
  id             String    @id @default(uuid())
  email          String
  organizationId String
  role           OrgRole   @default(VIEWER)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id                 String          @id @default(uuid())
  name               String
  code               String
  description        String?
  clientName         String?
  location           String?
  status             ProjectStatus   @default(PLANNING)
  priority           ProjectPriority @default(MEDIUM)
  budget             Decimal?        @db.Decimal(15, 2)
  spent              Decimal         @default(0) @db.Decimal(15, 2)
  progress           Int             @default(0)
  startDate          DateTime?
  expectedCompletion DateTime?
  actualCompletion   DateTime?
  organizationId     String
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  organization          Organization           @relation(fields: [organizationId], references: [id])
  members               ProjectMember[]
  dailyReports          DailyReport[]
  documents             Document[]
  activities            Activity[]
  workers               Worker[]
  materialMovements     MaterialMovement[]
  materialUsages        MaterialProjectUsage[]
  warehouses            Warehouse[]
  inventoryTransactions InventoryTransaction[]
  stockReservations     StockReservation[]
  purchaseOrders        PurchaseOrder[]
  rfqs                  Rfq[]
  invoices              Invoice[]
  payments              Payment[]
  budgetItems           BudgetItem[]
  cashFlowEntries       CashFlowEntry[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String     @id @default(uuid())
  projectId String
  userId    String
  role      MemberRole @default(ENGINEER)
  joinedAt  DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ─── Daily Reports ───────────────────────────────────────────────────────────

model DailyReport {
  id                String            @id @default(uuid())
  projectId         String
  organizationId    String
  submittedById     String
  date              DateTime          @db.Date
  weather           String?
  overallProgress   Int?
  workCompleted     String?
  remarks           String?
  labourCount       Int               @default(0)
  status            DailyReportStatus @default(DRAFT)
  aiSummary         String?
  labourDetails     Json?
  materialsConsumed Json?
  equipmentUsed     Json?
  issues            Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User       @relation(fields: [submittedById], references: [id])
  documents   Document[]

  @@index([projectId])
  @@index([organizationId])
  @@index([date])
  @@map("daily_reports")
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id             String   @id @default(uuid())
  name           String
  type           String
  mimeType       String
  size           Int
  url            String
  storageKey     String
  entityType     String
  entityId       String
  projectId      String?
  dailyReportId  String?
  organizationId String
  uploadedById   String
  createdAt      DateTime @default(now())

  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  dailyReport  DailyReport? @relation(fields: [dailyReportId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@map("documents")
}

// ─── Activity & Notifications ────────────────────────────────────────────────

model Activity {
  id             String   @id @default(uuid())
  type           String
  title          String
  description    String?
  metadata       Json?
  entityType     String?
  entityId       String?
  actorId        String
  projectId      String?
  organizationId String
  createdAt      DateTime @default(now())

  actor        User         @relation(fields: [actorId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([actorId])
  @@index([createdAt])
  @@map("activities")
}

model Notification {
  id             String           @id @default(uuid())
  type           NotificationType @default(INFO)
  title          String
  message        String
  read           Boolean          @default(false)
  entityType     String?
  entityId       String?
  userId         String
  organizationId String
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, read])
  @@index([organizationId])
  @@map("notifications")
}

// ─── Workforce ───────────────────────────────────────────────────────────────

model Worker {
  id                String       @id @default(uuid())
  name              String
  initials          String
  role              String
  trade             String
  type              WorkerType   @default(EMPLOYEE)
  phone             String?
  email             String?
  status            WorkerStatus @default(ACTIVE)
  experienceYears   Int          @default(0)
  shift             WorkerShift  @default(DAY)
  attendancePercent Float        @default(0)
  lastCheckIn       String?
  supervisor        String?
  projectId         String?
  emergencyContact  Json?
  skills            String[]
  certifications    Json?
  ppeCompliant      Boolean      @default(true)
  weeklyAttendance  Json?
  recentActivity    Json?
  organizationId    String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([organizationId, status])
  @@map("workers")
}

// ─── Materials ───────────────────────────────────────────────────────────────

enum MaterialMovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  CONSUMPTION
  ADJUSTMENT
}

model MaterialCategory {
  id             String   @id @default(uuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  materials    Material[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("material_categories")
}

model MaterialSupplier {
  id                 String   @id @default(uuid())
  name               String
  contactName        String?
  email              String?
  phone              String?
  address            String?
  leadTimeDays       Int      @default(7)
  rating             Float    @default(0)
  onTimeRate         Float    @default(0)
  openPurchaseOrders Int      @default(0)
  totalSpend         Decimal  @default(0) @db.Decimal(15, 2)
  organizationId     String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  materials    Material[]

  @@index([organizationId])
  @@map("material_suppliers")
}

model Material {
  id             String    @id @default(uuid())
  name           String
  sku            String
  unit           String
  unitCost       Decimal   @default(0) @db.Decimal(15, 2)
  quantity       Decimal   @default(0) @db.Decimal(15, 3)
  reserved       Decimal   @default(0) @db.Decimal(15, 3)
  incoming       Decimal   @default(0) @db.Decimal(15, 3)
  minStock       Decimal   @default(0) @db.Decimal(15, 3)
  maxStock       Decimal?  @db.Decimal(15, 3)
  warehouse      String?
  imageUrl       String?
  specifications Json?
  categoryId     String?
  supplierId     String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  category              MaterialCategory?      @relation(fields: [categoryId], references: [id])
  supplier              MaterialSupplier?      @relation(fields: [supplierId], references: [id])
  organization          Organization           @relation(fields: [organizationId], references: [id])
  movements             MaterialMovement[]
  usages                MaterialProjectUsage[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  stockTransferItems    StockTransferItem[]
  stockAdjustments      StockAdjustment[]

  @@unique([sku, organizationId])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, supplierId])
  @@index([organizationId, deletedAt])
  @@map("materials")
}

model MaterialMovement {
  id             String               @id @default(uuid())
  materialId     String
  type           MaterialMovementType
  quantity       Decimal              @db.Decimal(15, 3)
  reference      String?
  note           String?
  projectId      String?
  organizationId String
  occurredAt     DateTime             @default(now())
  createdAt      DateTime             @default(now())

  material     Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([materialId])
  @@index([projectId])
  @@index([occurredAt])
  @@map("material_movements")
}

model MaterialProjectUsage {
  id             String   @id @default(uuid())
  materialId     String
  projectId      String
  allocated      Decimal  @default(0) @db.Decimal(15, 3)
  consumed       Decimal  @default(0) @db.Decimal(15, 3)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  material     Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([materialId, projectId])
  @@index([organizationId])
  @@index([materialId])
  @@index([projectId])
  @@map("material_project_usages")
}

// ─── Inventory ───────────────────────────────────────────────────────────────

enum WarehouseType {
  CENTRAL
  SITE_STORE
  YARD
  TRANSIT
}

enum StockTransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
}

enum InventoryTransactionType {
  RECEIVE
  ISSUE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  CONSUMPTION
  RETURN
  DAMAGE
}

enum StockAdjustmentReason {
  CYCLE_COUNT
  DAMAGE
  LOSS
  FOUND
  CORRECTION
  RETURN
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model Warehouse {
  id             String        @id @default(uuid())
  name           String
  code           String
  type           WarehouseType @default(SITE_STORE)
  address        String?
  city           String?
  manager        String?
  capacity       Decimal?      @db.Decimal(15, 3)
  projectId      String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  project       Project?               @relation(fields: [projectId], references: [id])
  organization  Organization           @relation(fields: [organizationId], references: [id])
  locations     WarehouseLocation[]
  items         InventoryItem[]
  transactions  InventoryTransaction[]
  adjustments   StockAdjustment[]
  transfersFrom StockTransfer[]        @relation("TransferFrom")
  transfersTo   StockTransfer[]        @relation("TransferTo")

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([projectId])
  @@map("warehouses")
}

model WarehouseLocation {
  id             String   @id @default(uuid())
  name           String
  code           String
  zone           String?
  warehouseId    String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id])
  items        InventoryItem[]

  @@index([warehouseId])
  @@index([organizationId])
  @@map("warehouse_locations")
}

model InventoryItem {
  id             String   @id @default(uuid())
  materialId     String
  warehouseId    String
  locationId     String?
  quantity       Decimal  @default(0) @db.Decimal(15, 3)
  reserved       Decimal  @default(0) @db.Decimal(15, 3)
  damaged        Decimal  @default(0) @db.Decimal(15, 3)
  incoming       Decimal  @default(0) @db.Decimal(15, 3)
  reorderLevel   Decimal  @default(0) @db.Decimal(15, 3)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  material     Material               @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location     WarehouseLocation?     @relation(fields: [locationId], references: [id])
  organization Organization           @relation(fields: [organizationId], references: [id])
  transactions InventoryTransaction[]
  reservations StockReservation[]
  adjustments  StockAdjustment[]

  @@unique([materialId, warehouseId])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([materialId])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String                   @id @default(uuid())
  type            InventoryTransactionType
  quantity        Decimal                  @db.Decimal(15, 3)
  unitCost        Decimal                  @default(0) @db.Decimal(15, 2)
  reference       String?
  note            String?
  inventoryItemId String
  materialId      String
  warehouseId     String
  projectId       String?
  transferId      String?
  organizationId  String
  occurredAt      DateTime                 @default(now())
  createdAt       DateTime                 @default(now())

  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  material      Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id])
  transfer      StockTransfer? @relation(fields: [transferId], references: [id])
  organization  Organization   @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([warehouseId])
  @@index([materialId])
  @@index([projectId])
  @@index([occurredAt])
  @@map("inventory_transactions")
}

model StockTransfer {
  id              String              @id @default(uuid())
  code            String
  status          StockTransferStatus @default(PENDING)
  fromWarehouseId String
  toWarehouseId   String
  note            String?
  requestedBy     String?
  approvedBy      String?
  organizationId  String
  createdAt       DateTime            @default(now())
  approvedAt      DateTime?
  completedAt     DateTime?
  updatedAt       DateTime            @updatedAt

  fromWarehouse Warehouse              @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse              @relation("TransferTo", fields: [toWarehouseId], references: [id])
  organization  Organization           @relation(fields: [organizationId], references: [id])
  items         StockTransferItem[]
  transactions  InventoryTransaction[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id             String   @id @default(uuid())
  transferId     String
  materialId     String
  quantity       Decimal  @db.Decimal(15, 3)
  organizationId String
  createdAt      DateTime @default(now())

  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  material     Material      @relation(fields: [materialId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])

  @@index([transferId])
  @@index([organizationId])
  @@map("stock_transfer_items")
}

model StockAdjustment {
  id              String                @id @default(uuid())
  code            String
  reason          StockAdjustmentReason
  quantityBefore  Decimal               @db.Decimal(15, 3)
  quantityAfter   Decimal               @db.Decimal(15, 3)
  delta           Decimal               @db.Decimal(15, 3)
  note            String?
  adjustedBy      String?
  inventoryItemId String
  materialId      String
  warehouseId     String
  organizationId  String
  createdAt       DateTime              @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([warehouseId])
  @@map("stock_adjustments")
}

model StockReservation {
  id              String                 @id @default(uuid())
  inventoryItemId String
  quantity        Decimal                @db.Decimal(15, 3)
  status          StockReservationStatus @default(ACTIVE)
  note            String?
  projectId       String?
  organizationId  String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id])
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([inventoryItemId])
  @@map("stock_reservations")
}

model InventoryAudit {
  id             String   @id @default(uuid())
  warehouseId    String?
  accuracy       Float    @default(100)
  note           String?
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("inventory_audits")
}

model Vendor {
  id                    String    @id @default(uuid())
  name                  String
  code                  String
  categories            String[]
  status                String    @default("active")
  rating                Float     @default(0)
  performanceScore      Float     @default(0)
  onTimeDeliveryPercent Float     @default(0)
  deliveryAccuracy      Float     @default(0)
  qualityRating         Float     @default(0)
  responseTimeHours     Float     @default(0)
  projectCount          Int       @default(0)
  totalOrders           Int       @default(0)
  outstandingBalance    Decimal   @default(0) @db.Decimal(15, 2)
  lastOrderDate         DateTime?
  contactPerson         String?
  phone                 String?
  email                 String?
  gstNumber             String?
  paymentTerms          String?
  city                  String?
  state                 String?
  aiRecommendation      String?
  organizationId        String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("vendors")
}

model PurchaseOrder {
  id               String   @id @default(uuid())
  poNumber         String
  category         String
  createdBy        String
  approver         String
  requestedDate    DateTime @default(now())
  expectedDelivery DateTime
  amount           Decimal  @default(0) @db.Decimal(15, 2)
  approvalStatus   String   @default("pending")
  deliveryStatus   String   @default("not_started")
  priority         String   @default("medium")
  deliveryAddress  String   @default("")
  notes            String   @default("")
  projectId        String?
  vendorId         String?
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  project      Project?          @relation(fields: [projectId], references: [id])
  vendor       Vendor?           @relation(fields: [vendorId], references: [id])
  items        PoLineItem[]
  timeline     PoApprovalStep[]

  @@unique([poNumber, organizationId])
  @@index([organizationId])
  @@index([projectId])
  @@map("purchase_orders")
}

model PoLineItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  description     String
  category        String
  unit            String
  quantity        Decimal @default(0) @db.Decimal(15, 3)
  rate            Decimal @default(0) @db.Decimal(15, 2)
  taxPercent      Float   @default(0)
  discountPercent Float   @default(0)
  sortOrder       Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("po_line_items")
}

model PoApprovalStep {
  id              String    @id @default(uuid())
  purchaseOrderId String
  stage           String
  actor           String
  date            DateTime?
  note            String    @default("")
  sortOrder       Int       @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("po_approval_steps")
}

model Rfq {
  id                String   @id @default(uuid())
  rfqNumber         String
  title             String
  category          String
  vendorsInvited    Int      @default(0)
  responsesReceived Int      @default(0)
  issuedDate        DateTime @default(now())
  closingDate       DateTime
  status            String   @default("open")
  priority          String   @default("medium")
  estimatedValue    Decimal  @default(0) @db.Decimal(15, 2)
  createdBy         String
  projectId         String?
  organizationId    String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@unique([rfqNumber, organizationId])
  @@index([organizationId])
  @@map("rfqs")
}

model Delivery {
  id             String    @id @default(uuid())
  poNumber       String
  vendorName     String
  projectName    String
  category       String
  status         String    @default("pending")
  scheduledDate  DateTime
  actualDate     DateTime?
  itemSummary    String    @default("")
  delayDays      Int       @default(0)
  trackingId     String    @default("")
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("deliveries")
}

// ─── Finance ─────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  APPROVED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String
  vendorName     String
  vendorId       String?
  projectId      String?
  organizationId String
  category       String        @default("General")
  description    String        @default("")
  amount         Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(15, 2)
  status         InvoiceStatus @default(DRAFT)
  issuedDate     DateTime      @default(now())
  dueDate        DateTime
  paidDate       DateTime?
  notes          String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  payments     Payment[]

  @@unique([invoiceNumber, organizationId])
  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id             String        @id @default(uuid())
  paymentNumber  String
  invoiceId      String?
  vendorName     String
  projectId      String?
  organizationId String
  category       String        @default("General")
  amount         Decimal       @default(0) @db.Decimal(15, 2)
  status         PaymentStatus @default(PENDING)
  method         String        @default("bank_transfer")
  reference      String        @default("")
  paidDate       DateTime?
  dueDate        DateTime
  approvedBy     String?
  notes          String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([paymentNumber, organizationId])
  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@map("payments")
}

model BudgetItem {
  id             String   @id @default(uuid())
  projectId      String
  organizationId String
  category       String
  allocated      Decimal  @default(0) @db.Decimal(15, 2)
  spent          Decimal  @default(0) @db.Decimal(15, 2)
  committed      Decimal  @default(0) @db.Decimal(15, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([projectId, category])
  @@index([organizationId])
  @@index([projectId])
  @@map("budget_items")
}

model CashFlowEntry {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  month          Int
  year           Int
  inflow         Decimal  @default(0) @db.Decimal(15, 2)
  outflow        Decimal  @default(0) @db.Decimal(15, 2)
  forecastInflow  Decimal  @default(0) @db.Decimal(15, 2)
  forecastOutflow Decimal  @default(0) @db.Decimal(15, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, projectId, month, year])
  @@index([organizationId])
  @@map("cash_flow_entries")
}
model PushDevice {
  token       String   @id
  userId      String
  organizationId String
  platform    String   // ANDROID, IOS, WEB
  browser     String?
  deviceName  String?
  active      Boolean  @default(true)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, active])
  @@index([organizationId])
  @@map("push_devices")
}

model NotificationPreference {
  userId              String  @id
  checkIns            Boolean @default(true)
  checkInBlockers     Boolean @default(true)
  reviews             Boolean @default(true)
  recognition         Boolean @default(true)
  goals               Boolean @default(true)
  systemAnnouncements Boolean @default(true)
  workspace           Boolean @default(true)
  weeklyDigest        Boolean @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("notification_preferences")
}