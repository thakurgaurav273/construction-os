NODE_ENV=development

# Canonical app URL. Used to build links sent in emails, so it must be a single URL.
FRONTEND_URL=http://localhost:5173

# Browser origins allowed by CORS, comma separated. Falls back to FRONTEND_URL when empty.
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://sitepilot:sitepilot@localhost:5433/sitepilot

# Background jobs (reports, scheduled emails). Without it, jobs run in-process and are lost on restart.
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-minimum-64-characters-long-for-security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-64-characters-long-for-security
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=change-me-cookie-secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Number of reverse proxies / load balancers in front of the API, so rate limits see the real client IP.
# Leave unset when browsers connect to the API directly.
# TRUST_PROXY=1
# Requests per minute per signed-in person (per IP when signed out). Sign-in and AI calls have tighter limits.
# API_RATE_LIMIT_PER_MINUTE=300

# File storage. STORAGE_DRIVER is local (this server's disk, development only), s3 or r2.
# Platform admins can also connect a bucket (and Resend email) in Settings → Integrations, which takes precedence.
# Buckets stay private: files are shared through short-lived signed links. Keys never leave the server.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.storage
#
# Amazon S3: STORAGE_DRIVER=s3 with a bucket and region. Leave the keys unset to use an IAM role.
# STORAGE_BUCKET=sitepilot-files
# STORAGE_REGION=ap-south-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# Other S3-compatible servers (MinIO, Wasabi...): also set STORAGE_ENDPOINT (https in production) and keys.
# STORAGE_ENDPOINT=http://localhost:9000
#
# Cloudflare R2: STORAGE_DRIVER=r2 with the account ID and an R2 API token's keys (Object Read & Write, this bucket only).
# R2_ACCOUNT_ID=
# STORAGE_BUCKET=sitepilot-files
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# PUBLIC_API_URL=http://localhost:5174

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=noreply@sitepilot.app

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-6

NEXT_PUBLIC_API_URL=http://localhost:5174
NEXT_PUBLIC_APP_NAME=SitePilot
