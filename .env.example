NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://sitepilot:sitepilot@localhost:5432/sitepilot

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-minimum-64-characters-long-for-security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-64-characters-long-for-security
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=change-me-cookie-secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=sitepilot
STORAGE_PUBLIC_URL=http://localhost:9000/sitepilot

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=noreply@sitepilot.app

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-6

NEXT_PUBLIC_API_URL=http://localhost:5174
NEXT_PUBLIC_APP_NAME=SitePilot
